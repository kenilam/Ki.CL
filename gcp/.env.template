# The project the production services run in.
PROJECT={PROJECT}
# Where services are deployed and configured. Its config is what gets copied.
SOURCE_REGION={SOURCE_REGION}
# The region to copy into, and a free range for its subnet on NETWORK.
REGION={REGION}
RANGE={RANGE}
# Production services, space-separated. Put the ones others call first, so their URLs exist when the callers start.
SERVICES={SERVICES}
# The Cloud Build triggers that deploy those services on a push to main, space-separated.
TRIGGERS={TRIGGERS}
# The VPC network the services send their traffic through, the subnet they use in SOURCE_REGION,
# and the names for REGION's subnet, router and NAT.
NETWORK={NETWORK}
SOURCE_SUBNET={SOURCE_SUBNET}
SUBNET={SUBNET}
ROUTER={ROUTER}
NAT={NAT}
