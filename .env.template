NODE_ENV={NODE_ENV}
PORT={PORT}
# Cloudflare Turnstile site key. Unset skips the check (the API allows that outside production).
# Test keys: 1x00000000000000000000AA always passes, 3x00000000000000000000FF always asks for a click.
TURNSTILE_SITE_KEY={TURNSTILE_SITE_KEY}
# Design system remote (Ki.CL-design-system). Defaults to http://localhost:3200.
KICL_DESIGN_URL={KICL_DESIGN_URL}
# Moonshot exercise remote and API (Ki.CL-moonshot-exercise). Defaults to http://localhost:3301.
KICL_MOONSHOT_URL={KICL_MOONSHOT_URL}
# Moonshot's Vite dev server, e.g. http://localhost:3300, for hot updates. Unset, /moonshot goes to KICL_MOONSHOT_URL.
KICL_MOONSHOT_DEV_URL={KICL_MOONSHOT_DEV_URL}
# Public key that verifies client tokens (make client-token.keys prints it).
# Unset, every client token is refused.
KICL_CLIENT_PUBLIC_KEY={KICL_CLIENT_PUBLIC_KEY}
# Client token subjects to refuse before their tokens expire, comma-separated.
KICL_CLIENT_DENY={KICL_CLIENT_DENY}
# Phone number for the resume PDFs sent with an application (make resume.pdf.private).
# Local only: it is never built into the site or the public PDF.
KICL_RESUME_PHONE={KICL_RESUME_PHONE}
