{
  "name": "kicl",
  "version": "0.0.1",
  "description": "Ki.CL",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "App"
  ],
  "scripts": {
    "build:client": "yarn run clean:build && cross-env DEBUG=true VERBOSE=true yarn workspace app run build:client",
    "build:server": "cross-env DEBUG=true VERBOSE=true yarn workspace app run build:server",
    "clean:build": "cross-env DEBUG=true VERBOSE=true rm -rf App/build App/.Caches",
    "clean:remotes.renovate": "bash -c '\n  git fetch --prune > /dev/null;\n  branches=$(git branch -r --list \"origin/renovate/*\" | sed \"s/origin\\///\");\n  if [[ -z \"$branches\" ]]; then echo \"✅ No renovate branches found.\"; exit 0; fi;\n  echo \"⚠️  The following renovate branches will be deleted:\"; echo \"$branches\" | sed \"s/^/  - origin\\//\";\n  read -p \"Do you want to delete these branches? (y/N): \" confirm;\n  if [[ \"$confirm\" != \"y\" && \"$confirm\" != \"Y\" ]]; then echo \"❌ Aborted.\"; exit 1; fi;\n  for b in $branches; do echo \"Deleting origin/$b\"; git push origin --delete \"$b\"; done\n'",
    "clean:yarn": "rm -rf node_modules && yarn cache clean && rm yarn.lock",
    "deploy": "yarn run build:client && yarn run ftp",
    "development": "yarn run clean:build && cross-env DEBUG=true VERBOSE=true yarn workspace app run development",
    "ftp": "yarn workspace app run ftp",
    "lighthouse": "babel-node ./lighthouse/lightHouseTest.js",
    "lint:eslint": "eslint 'App/**/*.{js,jsx,ts,tsx}' --fix",
    "lint:staged": "lint-staged",
    "lint:stylelint": "stylelint 'App/**/*.{css,scss}' --fix",
    "prepare": "husky",
    "preview": "cross-env DEBUG=true VERBOSE=true yarn workspace app run preview",
    "production": "yarn run clean:build && cross-env DEBUG=true VERBOSE=true yarn workspace app run production",
    "start": "yarn install && yarn run development",
    "test": "npx jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenilam/kicl"
  },
  "keywords": [
    "react",
    "javascript",
    "viteJS",
    "SCSS"
  ],
  "bugs": {
    "url": "https://github.com/kenilam/kicl/issues/new"
  },
  "homepage": "https://github.com/kenilam/kicl",
  "author": "hello@ki-cl.com",
  "license": "ISC",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{css,js,jsx,ts,tsx,scss}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@babel/core": "7.27.1",
    "@babel/node": "7.27.1",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.27.1",
    "@babel/plugin-proposal-export-default-from": "7.27.1",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-proposal-private-methods": "7.18.6",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-modules-commonjs": "7.27.1",
    "@babel/plugin-transform-runtime": "7.27.1",
    "@babel/preset-env": "7.27.1",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@babel/register": "7.27.1",
    "@types/events": "3.0.3",
    "@ungap/url-search-params": "0.2.2",
    "app-root-path": "3.1.0",
    "autoprefixer": "10.5.4",
    "body-parser": "2.3.0",
    "core-js": "3.49.0",
    "cross-env": "10",
    "cypress-audit": "1.1.0",
    "dotenv": "17",
    "events": "3.3.0",
    "helmet": "8.3.0",
    "husky": "^9.1.7",
    "lighthouse": "13",
    "nodemon": "3.1.14",
    "path": "0.12.7",
    "postcss": "8.5.24",
    "postcss-exclude-files": "1.0.15",
    "postcss-ignore-plugin": "0.2.1",
    "postcss-import": "16.1.1",
    "postcss-js": "5",
    "postcss-preset-env": "11",
    "postcss-reporter": "7.1.0",
    "postcss-scss": "4.0.9",
    "postcss-url": "10.1.4",
    "sass": "1.102.0",
    "ts-node": "^10.9.2",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "web-vitals": "6",
    "yargs": "18"
  },
  "devDependencies": {
    "@commitlint/cli": "21",
    "@commitlint/config-conventional": "21",
    "@eslint/js": "10",
    "@faker-js/faker": "10",
    "@types/app-root-path": "3.1.0",
    "@types/body-parser": "1.19.6",
    "@types/node": "^24.0.0",
    "@types/node-sass": "4.11.8",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "babel-plugin-transform-import-meta": "3",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17",
    "lint-staged": "17",
    "prettier": "3.9.6",
    "stylelint": "17",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-recommended": "18",
    "stylelint-config-recommended-scss": "17",
    "stylelint-config-sass-guidelines": "13",
    "stylelint-config-standard": "40",
    "stylelint-config-standard-scss": "17",
    "stylelint-order": "8",
    "stylelint-prettier": "5.0.3",
    "stylelint-scss": "7"
  },
  "packageManager": "yarn@4.9.1"
}
