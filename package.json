{
  "name": "kicl",
  "version": "0.0.1",
  "description": "Loci",
  "engines": {
    "node": ">=23"
  },
  "workspaces": [
    "App"
  ],
  "scripts": {
    "build:client": "yarn run clean && cross-env DEBUG=true VERBOSE=true yarn workspace app run build:client",
    "build:server": "cross-env DEBUG=true VERBOSE=true yarn workspace app run build:server",
    "development": "yarn run clean && cross-env DEBUG=true VERBOSE=true yarn workspace app run development",
    "deploy": "yarn run build:client && yarn run ftp",
    "ftp": "yarn workspace app run ftp",
    "clean": "cross-env DEBUG=true VERBOSE=true rm -rf App/build App/.Caches",
    "lighthouse": "babel-node ./lighthouse/lightHouseTest.js",
    "lint:eslint": "eslint 'App/**/*.{js,jsx,ts,tsx}' --fix",
    "lint:staged": "lint-staged",
    "lint:stylelint": "stylelint 'App/**/*.{css,scss}' --fix",
    "preview": "cross-env DEBUG=true VERBOSE=true yarn workspace app run preview",
    "production": "yarn run clean && cross-env DEBUG=true VERBOSE=true yarn workspace app run production",
    "start": "yarn install && yarn run development",
    "test": "npx jest",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenilam/kicl"
  },
  "keywords": [
    "react",
    "javascript",
    "viteJS",
    "SCSS"
  ],
  "bugs": {
    "url": "https://github.com/kenilam/kicl/issues/new"
  },
  "homepage": "https://github.com/kenilam/kicl",
  "author": "hello@ki-cl.com",
  "license": "ISC",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{css,js,jsx,ts,tsx,scss}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@babel/core": "7.27.1",
    "@babel/node": "7.27.1",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.27.1",
    "@babel/plugin-proposal-export-default-from": "7.27.1",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-proposal-private-methods": "7.18.6",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-modules-commonjs": "7.27.1",
    "@babel/plugin-transform-runtime": "7.27.1",
    "@babel/preset-env": "7.27.1",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@babel/register": "7.27.1",
    "@types/events": "3.0.3",
    "@ungap/url-search-params": "0.2.2",
    "app-root-path": "3.1.0",
    "autoprefixer": "10.4.21",
    "body-parser": "^2.2.0",
    "core-js": "3.42.0",
    "cross-env": "7.0.3",
    "cypress-audit": "1.1.0",
    "dotenv": "16.5.0",
    "events": "3.3.0",
    "helmet": "8.1.0",
    "husky": "^9.1.7",
    "lighthouse": "12.6.0",
    "nodemon": "^3.1.10",
    "path": "0.12.7",
    "postcss": "8.5.3",
    "postcss-exclude-files": "1.0.15",
    "postcss-ignore-plugin": "0.2.1",
    "postcss-import": "16.1.0",
    "postcss-js": "4.0.1",
    "postcss-preset-env": "10.1.6",
    "postcss-reporter": "7.1.0",
    "postcss-scss": "4.0.9",
    "postcss-url": "10.1.3",
    "sass": "1.87.0",
    "ts-node": "^10.9.2",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "web-vitals": "4.2.4",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "@eslint/js": "^9.26.0",
    "@faker-js/faker": "^9.7.0",
    "@types/app-root-path": "3.1.0",
    "@types/body-parser": "^1.19.5",
    "@types/node": "22.15.3",
    "@types/node-sass": "4.11.8",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "babel-plugin-transform-import-meta": "^2.3.2",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.26.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "lint-staged": "15.5.1",
    "prettier": "3.5.3",
    "stylelint": "16.19.1",
    "stylelint-config-css-modules": "4.4.0",
    "stylelint-config-recommended": "16.0.0",
    "stylelint-config-recommended-scss": "14.1.0",
    "stylelint-config-sass-guidelines": "12.1.0",
    "stylelint-config-standard": "38.0.0",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "5.0.3",
    "stylelint-scss": "6.11.1"
  },
  "packageManager": "yarn@3.8.7"
}
