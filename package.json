{
  "name": "kicl",
  "version": "0.0.1",
  "description": "Loci",
  "engines": {
    "node": ">=23"
  },
  "workspaces": [
    "App"
  ],
  "scripts": {
    "build:client": "yarn run clean && cross-env DEBUG=true VERBOSE=true yarn workspace app run build:client",
    "build:server": "cross-env DEBUG=true VERBOSE=true yarn workspace app run build:server",
    "development": "yarn run clean && cross-env DEBUG=true VERBOSE=true yarn workspace app run development",
    "deploy": "yarn run build:client && yarn run ftp",
    "ftp": "yarn workspace app run ftp",
    "clean": "cross-env DEBUG=true VERBOSE=true rm -rf App/build App/.Caches",
    "lighthouse": "babel-node ./lighthouse/lightHouseTest.js",
    "lint:eslint": "eslint 'App/**/*.{js,jsx,ts,tsx}' --fix",
    "lint:staged": "lint-staged",
    "lint:stylelint": "stylelint 'App/**/*.{css,scss}' --fix",
    "preview": "cross-env DEBUG=true VERBOSE=true yarn workspace app run preview",
    "production": "yarn run clean && cross-env DEBUG=true VERBOSE=true yarn workspace app run production",
    "start": "yarn install && yarn run development",
    "test": "npx jest",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenilam/kicl"
  },
  "keywords": [
    "react",
    "javascript",
    "viteJS",
    "SCSS"
  ],
  "bugs": {
    "url": "https://github.com/kenilam/kicl/issues/new"
  },
  "homepage": "https://github.com/kenilam/kicl",
  "author": "hello@ki-cl.com",
  "license": "ISC",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{css,js,jsx,ts,tsx,scss}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@babel/core": "7.24.7",
    "@babel/node": "7.27.1",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.24.7",
    "@babel/plugin-proposal-export-default-from": "7.24.7",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-proposal-private-methods": "7.18.6",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-modules-commonjs": "7.24.7",
    "@babel/plugin-transform-runtime": "7.24.7",
    "@babel/preset-env": "7.24.7",
    "@babel/preset-react": "7.24.7",
    "@babel/preset-typescript": "7.24.7",
    "@babel/register": "7.24.6",
    "@types/events": "3.0.3",
    "@ungap/url-search-params": "0.2.2",
    "app-root-path": "3.1.0",
    "autoprefixer": "10.4.19",
    "body-parser": "^1.20.2",
    "core-js": "3.37.1",
    "cross-env": "7.0.3",
    "cypress-audit": "1.1.0",
    "dotenv": "16.4.5",
    "events": "3.3.0",
    "helmet": "7.1.0",
    "husky": "^9.0.11",
    "lighthouse": "12.0.0",
    "nodemon": "^3.1.3",
    "path": "0.12.7",
    "postcss": "8.4.38",
    "postcss-exclude-files": "1.0.15",
    "postcss-ignore-plugin": "0.2.1",
    "postcss-import": "16.1.0",
    "postcss-js": "4.0.1",
    "postcss-preset-env": "9.5.14",
    "postcss-reporter": "7.1.0",
    "postcss-scss": "4.0.9",
    "postcss-url": "10.1.3",
    "sass": "1.77.5",
    "ts-node": "^10.9.2",
    "tslib": "2.6.3",
    "typescript": "5.4.5",
    "web-vitals": "4.1.1",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@eslint/js": "^9.4.0",
    "@faker-js/faker": "^8.4.1",
    "@types/app-root-path": "1.2.8",
    "@types/body-parser": "^1.19.5",
    "@types/node": "20.14.2",
    "@types/node-sass": "4.11.7",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "babel-plugin-transform-import-meta": "^2.2.1",
    "commitizen": "4.3.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "9.4.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^15.4.0",
    "lint-staged": "15.2.7",
    "prettier": "3.3.2",
    "stylelint": "16.6.1",
    "stylelint-config-css-modules": "4.4.0",
    "stylelint-config-recommended": "14.0.0",
    "stylelint-config-recommended-scss": "14.0.0",
    "stylelint-config-sass-guidelines": "11.1.0",
    "stylelint-config-standard": "36.0.0",
    "stylelint-config-standard-scss": "13.1.0",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "5.0.0",
    "stylelint-scss": "6.3.1"
  },
  "packageManager": "yarn@3.3.0"
}
