{
  "name": "kicl",
  "version": "0.0.1",
  "description": "https://ki-cl.com",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "App"
  ],
  "scripts": {
    "build:client": "cross-env DEBUG=true VERBOSE=true yarn workspace app run build:client",
    "build:server": "cross-env DEBUG=true VERBOSE=true yarn workspace app run build:server",
    "development": "cross-env DEBUG=true VERBOSE=true yarn workspace app run development",
    "preview": "cross-env DEBUG=true VERBOSE=true yarn workspace app run preview",
    "production": "cross-env DEBUG=true VERBOSE=true yarn workspace app run production",
    "lighthouse": "babel-node ./lighthouse/lightHouseTest.js",
    "lint:eslint": "eslint 'App/**/*.{js,jsx,ts,tsx}' --fix",
    "lint:staged": "lint-staged",
    "lint:stylelint": "stylelint 'App/**/*.{css,scss}' --fix",
    "postinstall": "husky install",
    "start": "yarn install && yarn run app:run",
    "test": "npx jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenilam/Ki.CL"
  },
  "keywords": [
    "react",
    "javascript",
    "viteJS",
    "SCSS"
  ],
  "bugs": {
    "url": "https://github.com/kenilam/Ki.CL/issues/new"
  },
  "homepage": "https://github.com/kenilam/Ki.CL",
  "author": "hello@ki-cl.com",
  "license": "ISC",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{css,js,jsx,ts,tsx,scss}": [
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --allow-empty-input"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@babel/core": "7.20.12",
    "@babel/node": "7.20.7",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.20.7",
    "@babel/plugin-proposal-export-default-from": "7.18.10",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-proposal-private-methods": "7.18.6",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-modules-commonjs": "7.20.11",
    "@babel/plugin-transform-runtime": "7.19.6",
    "@babel/preset-env": "7.20.2",
    "@babel/preset-react": "7.18.6",
    "@babel/preset-typescript": "7.18.6",
    "@babel/register": "7.18.9",
    "@types/app-root-path": "1.2.4",
    "@types/events": "3.0.0",
    "@types/express": "4.17.15",
    "@types/glob": "8.0.0",
    "@ungap/url-search-params": "0.2.2",
    "@vite/vitejs-client": "2.2.10",
    "app-root-path": "3.1.0",
    "autoprefixer": "10.4.13",
    "colors": "1.4.0",
    "core-js": "3.27.1",
    "cross-env": "7.0.3",
    "cypress-audit": "1.1.0",
    "events": "3.3.0",
    "express": "4.18.2",
    "glob": "8.0.3",
    "helmet": "6.0.1",
    "husky": "8.0.3",
    "lighthouse": "9.6.8",
    "path": "0.12.7",
    "postcss": "8.4.21",
    "postcss-exclude-files": "1.0.15",
    "postcss-ignore-plugin": "0.2.1",
    "postcss-import": "15.1.0",
    "postcss-js": "4.0.0",
    "postcss-preset-env": "7.8.3",
    "postcss-reporter": "7.0.5",
    "postcss-scss": "4.0.6",
    "postcss-url": "10.1.3",
    "sass": "1.57.1",
    "stylelint": "14.16.1",
    "stylelint-config-css-modules": "4.1.0",
    "stylelint-config-recommended": "9.0.0",
    "stylelint-config-recommended-scss": "8.0.0",
    "stylelint-config-sass-guidelines": "9.0.1",
    "stylelint-config-standard": "29.0.0",
    "stylelint-config-standard-scss": "6.1.0",
    "stylelint-prettier": "2.0.0",
    "stylelint-scss": "4.3.0",
    "tslib": "2.4.1",
    "typescript": "4.9.4",
    "web-vitals": "3.1.1",
    "yargs": "17.6.2"
  },
  "devDependencies": {
    "@commitlint/cli": "17.4.2",
    "@commitlint/config-conventional": "17.4.2",
    "@types/app-root-path": "1.2.4",
    "@types/node": "18.11.18",
    "@types/node-sass": "4.11.3",
    "@typescript-eslint/eslint-plugin": "5.48.1",
    "@typescript-eslint/parser": "5.48.1",
    "babel-eslint": "10.1.0",
    "babel-plugin-transform-import-meta": "^2.2.0",
    "commitizen": "4.2.6",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.31.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "8.6.0",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-import": "2.27.4",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-react": "7.32.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "lint-staged": "13.1.0",
    "prettier": "2.8.2",
    "ts-jest-mock-import-meta": "^1.0.0"
  },
  "packageManager": "yarn@3.3.0"
}
