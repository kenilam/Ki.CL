{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "^/*": ["../*"],
      "@/*": ["./*"],
      "api": ["./@mf-types/api"],
      "api/*": ["./@mf-types/api/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    ".Caches/**/*",
    "@mf-types/**/*",
    "build/**/*",
    "API/Client/Types/**/*",
    "node_modules/**/*"
  ]
}
