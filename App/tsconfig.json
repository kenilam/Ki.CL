{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "^/*": [
        "../*"
      ],
      "@/*": [
        "./*"
      ],
      "api": [
        "./@mf-types/api"
      ],
      "api/*": [
        "./@mf-types/api/*"
      ],
      "arm": [
        "./@mf-types/arm"
      ],
      "arm/*": [
        "./@mf-types/arm/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    ".Caches/**/*",
    "@mf-types/**/*",
    "API/Client/Types/**/*",
    "build/**/*",
    "node_modules/**/*"
  ]
}
