{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "^/*": [
        "../*"
      ],
      "@/*": [
        "./*"
      ],
      "api": [
        "./@mf-types/api"
      ],
      "api/*": [
        "./@mf-types/api/*"
      ],
      "design": [
        "./@mf-types/design"
      ],
      "design/*": [
        "./@mf-types/design/*"
      ],
      "moonshot": [
        "./@mf-types/moonshot"
      ],
      "moonshot/*": [
        "./@mf-types/moonshot/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    ".Caches/**/*",
    "@mf-types/**/*",
    "API/Client/Types/**/*",
    "build/**/*",
    "node_modules/**/*"
  ]
}
